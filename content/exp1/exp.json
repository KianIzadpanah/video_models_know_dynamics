{
  "id": "exp1",
  "nav": "Exp 1",
  "title": "The round trip — does motion come back more natural than it went in?",
  "question": "Send a motion through the video model and pull it back out as motion. If the video model knows how bodies move, what comes back should look more natural than what went in — not identical to it.",
  "status": "complete",
  "date": "2026-08-23",
  "tags": [
    "MotionGPT3",
    "LTX-2.5",
    "GVHMR",
    "SMPL"
  ],
  "source_dir": "../Exp 01 - Comparing 3D motions of Loose Control and T2M",
  "media": {
    "seeds": [
      "1234",
      "5678"
    ],
    "default_seeds": [
      "1234"
    ],
    "items": {
      "box_heavy": {
        "text": "a person lifts a heavy box from the floor",
        "verdict": "improved",
        "meta": {
          "the beat": "the load is taken up — pause at the bottom, then the slow rise"
        }
      },
      "barbell_heavy": {
        "text": "a person lifts a heavy barbell from the ground",
        "verdict": "no-change",
        "meta": {
          "the beat": "the break off the floor, then acceleration past the knees"
        }
      },
      "push_heavy": {
        "text": "a person pushes a car",
        "verdict": "no-change",
        "meta": {
          "the beat": "the lean into the load before anything moves"
        }
      },
      "punch": {
        "text": "a person throws right and left punches",
        "verdict": "partial",
        "meta": {
          "the beat": "hip rotation leads each arm, recovery between punches"
        }
      },
      "squat": {
        "text": "a person squats down",
        "verdict": "unusable",
        "meta": {
          "the beat": "controlled descent, bottom position, drive back up"
        }
      },
      "baseball": {
        "text": "a person hit a ball with baseball bat",
        "verdict": "marginal",
        "meta": {
          "the beat": "load onto the back foot, pause, then rotation through contact"
        }
      }
    },
